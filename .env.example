# Google スプレッドシート連携の設定（server/ が読み込む）。
# 未設定の場合、アプリは localStorage のみで動作します（同期はOFF）。

# 1) データを蓄積するスプレッドシートのID
#    URL: https://docs.google.com/spreadsheets/d/<このID>/edit
GOOGLE_SPREADSHEET_ID=

# 2) サービスアカウントの認証情報（どちらか一方）
#    (a) 鍵JSONファイルのパスを指定する場合
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#    (b) 鍵JSONの中身を丸ごと1行で貼る場合（デプロイ向け）。(a)より優先されます
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# 任意
# PORT=8787
