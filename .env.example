# Notion 連携の設定（server/ が読み込む）。
# 未設定の場合、アプリは localStorage のみで動作します（Notion 同期はOFF）。

# 1) https://www.notion.so/my-integrations で内部インテグレーションを作成し、
#    "Internal Integration Secret" を貼り付ける
NOTION_TOKEN=

# 2) データベースを作成したい親ページのID。
#    そのページを開き「…」→「コネクトを追加」で上記インテグレーションを接続してから、
#    ページURL末尾の32桁（ハイフンなし）を貼り付ける
#    例: https://www.notion.so/My-Page-<32桁> → その<32桁>
NOTION_PARENT_PAGE_ID=

# 任意
# NOTION_VERSION=2022-06-28
# PORT=8787
